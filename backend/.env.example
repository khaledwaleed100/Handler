# ============================================================
# Five-a-Side: environment variables
# Copy to .env (local) or set in Render's dashboard. NEVER commit real values.
# ============================================================

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/five-a-side?retryWrites=true&w=majority

PORT=3000
NODE_ENV=production

# Only needed if the frontend is hosted somewhere else (not served by this server)
FRONTEND_URL=

# The organizer's email. Signing up with this email creates the organizer
# account and doesn't need an invite link. Everyone else needs the invite link.
ORGANIZER_EMAIL=you@example.com

# Secrets: at least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Scheduled jobs (reminders, closing rating rounds). At least 16 characters.
# Point a free scheduler (e.g. cron-job.org) at POST /api/cron/tick every 15-30 min
# with the header  x-cron-secret: <this value>
CRON_SECRET=

# Phone notifications. Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Player photos (https://cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail for password reset codes:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
