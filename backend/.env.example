# ============================================================
# The Handler: environment variables
#
# Local:  copy this file to backend/.env and fill it in.
# Render: add each line in Dashboard → your service → Environment.
# NEVER commit a real .env file (it's already in .gitignore).
# ============================================================

# ── Required ─────────────────────────────────────────────────

NODE_ENV=production

# MongoDB Atlas → Connect → Drivers → copy the connection string.
# Use a database user that only has "readWrite" on this database.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/the-handler?retryWrites=true&w=majority

# Your public address, used in email links. No trailing slash.
APP_URL=https://the-handler.onrender.com

# Two different random secrets, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Your email. This account becomes the organizer.
ORGANIZER_EMAIL=you@gmail.com

# Only needed if you create the organizer account with a password instead of Google.
# Any random text of 8+ characters; you type it once on the sign-up screen.
ORGANIZER_SETUP_CODE=

# ── Google sign-in (recommended) ─────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Without it, the "Continue with Google" button simply doesn't show.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── Player photos (Cloudinary) ───────────────────────────────
# cloudinary.com → Dashboard → "API Keys". Without these, photo upload says "not set up".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email: password reset codes + notifications (Gmail) ──────
# Google Account → Security → 2-Step Verification (turn on) → App passwords → create one.
# Paste the 16 letters without spaces. Gmail allows ~500 emails a day: plenty for a group.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# On Render's free plan Gmail can't be reached (outgoing SMTP is blocked).
# Use Brevo instead: it sends over HTTPS. When BREVO_API_KEY is set it is used first.
BREVO_API_KEY=
# The sender address, verified in Brevo (Senders & IPs). Defaults to GMAIL_USER.
EMAIL_FROM=you@gmail.com

# ── Phone notifications (Web Push) ───────────────────────────
# Run once, anywhere:  npx web-push generate-vapid-keys
# Keep the same keys forever; changing them silently unsubscribes every phone.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# ── Optional ─────────────────────────────────────────────────
# Only if the frontend is hosted on a different domain (not needed on Render's single service).
FRONTEND_URL=
